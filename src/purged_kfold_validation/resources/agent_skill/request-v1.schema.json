{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quantskills/skill-ml-purged-cv/request-v1.schema.json",
  "title": "Purged CV Agent request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "data_path", "manifest_path", "mapping_path"],
  "properties": {
    "schema_version": {"const": "1"},
    "action": {"enum": ["audit", "evaluate"]},
    "data_path": {"type": "string", "minLength": 1},
    "manifest_path": {"type": "string", "minLength": 1},
    "mapping_path": {"type": "string", "minLength": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600, "default": 900},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_file_bytes": {"type": "integer", "minimum": 1},
        "max_rows": {"type": "integer", "minimum": 1},
        "max_features": {"type": "integer", "minimum": 1},
        "max_combinations": {"type": "integer", "minimum": 1},
        "max_columns": {"type": "integer", "minimum": 1},
        "max_uncompressed_bytes": {"type": "integer", "minimum": 1},
        "n_groups": {"type": "integer", "minimum": 2},
        "n_test_groups": {"type": "integer", "minimum": 1},
        "walk_forward_splits": {"type": "integer", "minimum": 1},
        "embargo_sessions": {"type": "integer", "minimum": 0},
        "pre_test_gap_sessions": {"type": "integer", "minimum": 0},
        "min_train_observations": {"type": "integer", "minimum": 1},
        "min_train_sessions": {"type": "integer", "minimum": 1},
        "min_train_assets": {"type": "integer", "minimum": 1},
        "ridge_alpha": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "audit"}}},
      "then": {
        "properties": {
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_file_bytes": {"type": "integer", "minimum": 1},
              "max_rows": {"type": "integer", "minimum": 1},
              "max_features": {"type": "integer", "minimum": 1},
              "max_combinations": {"type": "integer", "minimum": 1},
              "max_columns": {"type": "integer", "minimum": 1},
              "max_uncompressed_bytes": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  ]
}
