{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quantskills/skill-ml-purged-cv/result-v1.schema.json",
  "title": "Purged CV Agent result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "action", "engine", "authoritative_cli_result", "warnings", "errors"],
  "properties": {
    "schema_version": {"const": "1"},
    "status": {"enum": ["success", "rejected"]},
    "action": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "purged-kfold-validation"},
        "version": {"type": "string"}
      }
    },
    "authoritative_cli_result": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error_type", "message"],
        "properties": {
          "error_type": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    }
  }
}
