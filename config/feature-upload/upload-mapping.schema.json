{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantskills.local/purged-kfold-validation/upload-mapping-v1.schema.json",
  "title": "Governed feature upload mapping v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sample_id_column", "session_column", "asset_id_column",
    "interval_start_column", "interval_end_column", "decision_time_column",
    "target_column", "feature_columns", "availability_columns", "session_axis",
    "pit_snapshot"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "sample_id_column": {"type": "string", "minLength": 1},
    "session_column": {"type": "string", "minLength": 1},
    "asset_id_column": {"type": ["string", "null"], "minLength": 1},
    "interval_start_column": {"type": "string", "minLength": 1},
    "interval_end_column": {"type": "string", "minLength": 1},
    "decision_time_column": {"type": "string", "minLength": 1},
    "target_column": {"type": "string", "minLength": 1},
    "feature_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "availability_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "session_axis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "date-time"}},
    "pit_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "source_digest", "revision_policy"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "revision_policy": {"const": "point-in-time"}
      }
    }
  }
}
